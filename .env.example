# Qorvai AI — Environment Variables
# Copy this file to .env and fill in your values

# Required for email generation and lead scoring
OPENAI_API_KEY=sk-proj-...

# Optional: Gmail for auto-sending cold emails
EMAIL_FROM=you@gmail.com
EMAIL_PASS=your-gmail-app-password

# Optional: Instagram credentials for hashtag scraping
IG_USER=your_instagram_username
IG_PASS=your_instagram_password

# Optional: Rotating proxy to avoid blocks (format: http://user:pass@host:port)
PROXY_URL=

# Optional: Stripe secret key for subscription payments
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: HubSpot CRM sync
HUBSPOT_API_KEY=
